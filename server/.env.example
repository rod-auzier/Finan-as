# =============================================================================
# Exemplo de variáveis de ambiente do backend (uso LOCAL).
# Copie este arquivo para ".env" e ajuste os valores.
#   cp .env.example .env      (Linux/macOS)
#   copy .env.example .env    (Windows CMD)
#   Copy-Item .env.example .env   (PowerShell)
#
# O arquivo .env NÃO deve ser versionado (está no .gitignore/.vercelignore).
# No deploy da Vercel estas variáveis são definidas no painel do projeto
# (Settings -> Environment Variables), não neste arquivo. Ver README.
# =============================================================================

# Porta HTTP em que o servidor Express vai escutar.
PORT=3001

# String de conexão do MongoDB.
# Local:  mongodb://127.0.0.1:27017/painel-financeiro
# Atlas:  mongodb+srv://<usuario>:<senha>@<cluster>/painel-financeiro
MONGO_URI=mongodb://127.0.0.1:27017/painel-financeiro

# Segredo usado para assinar e verificar os tokens JWT.
# Use uma string longa e aleatória. Ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=defina-uma-string-secreta-longa-e-aleatoria

# Tempo de expiração do token JWT (formato aceito pela lib "jsonwebtoken").
JWT_EXPIRES_IN=7d

# URL do frontend, para restringir o CORS (opcional).
# Local com proxy do Vite: pode deixar em branco.
CLIENT_URL=
